# ── Environnement ──────────────────────────────────────────────
# "development" ou "production"
NODE_ENV=development

# ── Base de données ─────────────────────────────────────────────
# PRODUCTION (Supabase) : remplir DB_URL et laisser les autres vides
DB_URL=""

# DÉVELOPPEMENT (local) : remplir les champs individuels
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="mot de passe postgres"
DB_NAME="Gestion_RH"

# ── Auth ────────────────────────────────────────────────────────
JWT_SECRET='your_strong_random_secret_here'

# ── Microservice IA ─────────────────────────────────────────────
# DEV : http://localhost:5000
# PROD : https://ton-ia-service.onrender.com
IA_SERVICE_URL=http://localhost:5000

# ── CORS Frontend ───────────────────────────────────────────────
# DEV
FRONTEND_URL_DEV=http://localhost:5173
# PROD (URL Vercel)
FRONTEND_URL_PROD=https://ton-app.vercel.app

# Supabase Storage (PDFs des contrats)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=ta_service_role_key_ici
