# ── Environnement ──────────────────────────────────────────────────────────────
# "development" ou "production"
NODE_ENV=development

# ── Base de données ─────────────────────────────────────────────────────────────
# PRODUCTION (Supabase / Railway) : renseigner DB_URL
DB_URL=""

# DÉVELOPPEMENT (PostgreSQL local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ton_mot_de_passe
DB_NAME=cookshare

# ── JWT (Access Token) ──────────────────────────────────────────────────────────
# Clé secrète pour signer les access tokens (courte durée de vie)
JWT_SECRET=change_me_super_secret_access_key
# Durée de vie de l'access token (15 minutes recommandé)
JWT_EXPIRES_IN=15m

# ── JWT (Refresh Token) ─────────────────────────────────────────────────────────
# Clé DIFFÉRENTE pour les refresh tokens (longue durée de vie)
JWT_REFRESH_SECRET=change_me_super_secret_refresh_key
# Durée de vie du refresh token (7 jours)
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary (upload d'images) ────────────────────────────────────────────────
# Créer un compte gratuit sur https://cloudinary.com
CLOUDINARY_CLOUD_NAME=ton_cloud_name
CLOUDINARY_API_KEY=ton_api_key
CLOUDINARY_API_SECRET=ton_api_secret

# ── Application ─────────────────────────────────────────────────────────────────
PORT=3000
# URL du frontend pour CORS
FRONTEND_URL=http://localhost:5173
