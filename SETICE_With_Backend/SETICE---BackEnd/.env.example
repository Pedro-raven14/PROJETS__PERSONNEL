# Configuration Email - Choisir UNE des options ci-dessous

# Option 1: EmailJS (Recommandée - utilise Gmail directement)
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_SERVICE_ID=your_gmail_service_id
EMAILJS_TEMPLATE_ID=your_template_id

# Option 2: SMTP2GO (Alternative robuste)
SMTP2GO_USERNAME=your_smtp2go_username
SMTP2GO_PASSWORD=your_smtp2go_password
SMTP2GO_FROM_EMAIL=noreply@votre-app.com

# Option 3: Mailtrap (Déjà configuré)
EMAIL_HOST=live.smtp.mailtrap.io
EMAIL_USER=your_mailtrap_user
EMAIL_PASSWORD=your_mailtrap_password
EMAIL_FROM=your_demo_email@mailtrap.io

# Configuration générale
FRONT_URL=https://votre-frontend.vercel.app