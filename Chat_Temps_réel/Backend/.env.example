# ── Environnement ──────────────────────────────────────────────
NODE_ENV=development

# ── Base de données PostgreSQL ──────────────────────────────────
# PRODUCTION (Supabase / Railway / Render) : remplir DB_URL uniquement
DB_URL=""

# DÉVELOPPEMENT (local PostgreSQL) : remplir les champs ci-dessous
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ton_mot_de_passe
DB_NAME=nebula_chat

# ── Authentification JWT ────────────────────────────────────────
# Génère une valeur aléatoire longue : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ── CORS Frontend ───────────────────────────────────────────────
FRONTEND_URL_DEV=http://localhost:5173
FRONTEND_URL_PROD=https://ton-app.vercel.app

# ── Port serveur ─────────────────────────────────────────────────
PORT=3000
